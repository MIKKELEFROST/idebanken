# Kopiér til .env.local og udfyld med værdierne fra
# Supabase → Project Settings → API for projektet "IdeBanken".
#
# Begge er offentlige nøgler, der er beregnet til at ligge i browseren.
# Service role-nøglen hører ikke hjemme her og må aldrig i et frontend-projekt.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key>
